# ===================== 服务端口 =====================
PORT=3000

# ===================== MySQL 数据库配置 =====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_store_saas
DB_CONNECTION_LIMIT=10

# ===================== JWT 配置 =====================
# 生产环境务必替换为足够长的随机字符串
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===================== bcrypt 哈希强度 =====================
BCRYPT_SALT_ROUNDS=10

# ===================== AI 每日调用默认上限 =====================
# 租户当日配额缺失时,使用该值初始化 daily_limit
AI_DAILY_DEFAULT_LIMIT=100

# ===================== 数据库定时备份 =====================
# 备份文件存放目录,每天 03:00 执行,保留 7 天滚动覆盖
BACKUP_DIR=/backup

# ===================== DeepSeek LLM 配置 =====================
# API Key 只从环境变量读取,禁止在代码中硬编码
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# ===================== 即梦 AI / 火山引擎 视频生成 =====================
# 火山引擎 AK/SK(V4 HMAC-SHA256 签名用)
VOLC_AK=
VOLC_SK=
# 即梦视频任务 req_key
JIMENG_REQ_KEY=jimeng_realman_avatar_picture_omni_v15

# ===================== 日志 =====================
# 日志级别: debug/info/warn/error
LOG_LEVEL=info
# 日志目录(默认项目根目录 logs/)
LOG_DIR=
